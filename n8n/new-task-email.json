      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1320, 60]
    },
    {
      "parameters": {
        "jsCode": "// Construit le sujet et le corps HTML de l'e-mail de confirmation.\n// N'inclut jamais de clé/secret dans le contenu envoyé.\nconst task = $node[\"Extraire la tâche\"].json;\nconst project = ($node[\"Récupérer le projet\"].json && $node[\"Récupérer le projet\"].json[0]) || {};\nconst appBaseUrl = $env.APP_BASE_URL || \"\";\n\nconst priorityLabels = { low: \"Basse\", medium: \"Moyenne\", high: \"Haute\" };\nconst priorityLabel = priorityLabels[task.task_priority] || task.task_priority;\n\nconst dueDate = task.task_due_date\n  ? new Date(task.task_due_date).toLocaleDateString(\"fr-CA\")\n  : \"Non définie\";\n\nconst linkHtml = appBaseUrl\n  ? `<p><a href=\"${appBaseUrl}/tasks/${task.task_id}\" style=\"color:#2563eb;\">Voir la tâche dans ProjectFlow</a></p>`\n  : \"\";\n\nconst html = `\n  <div style=\"font-family:Arial,sans-serif;color:#111;max-width:520px;\">\n    <h2 style=\"color:#2563eb;\">ProjectFlow</h2>\n    <p>Une nouvelle tâche vient d'être créée :</p>\n    <ul>\n      <li><strong>Titre :</strong> ${task.task_title}</li>\n      <li><strong>Projet :</strong> ${project.title || \"Non renseigné\"}</li>\n      <li><strong>Priorité :</strong> ${priorityLabel}</li>\n      <li><strong>Échéance :</strong> ${dueDate}</li>\n    </ul>\n    ${linkHtml}\n    <p style=\"color:#888;font-size:12px;\">Cet e-mail est un canal complémentaire aux notifications internes ProjectFlow.</p>\n  </div>\n`;\n\nreturn [{ json: { subject: \"ProjectFlow — Nouvelle tâche créée\", html } }];"
      },
      "id": "code-build-email",
      "name": "Construire l'e-mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -160]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM_EMAIL || 'notifications@projectflow.app'}}",
        "toEmail": "={{$node[\"Récupérer l'utilisateur Auth\"].json.email}}",
        "subject": "={{$node[\"Construire l'e-mail\"].json.subject}}",
        "html": "={{$node[\"Construire l'e-mail\"].json.html}}",
        "options": {}
      },
      "id": "email-send-new-task",
      "name": "Envoyer l'e-mail de confirmation",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1540, -160],
